# GitHub — Issues + PRs read/write + merge (classic PAT or fine-grained with contents + pull_requests)
GITHUB_TOKEN=

# Optional — protect write routes when deployed to baidigital.office.xyz
# OFFICE_SECRET=

# Auto-pickup: poll GitHub for agent:ready and dispatch Claude Code agents
AGENT_POLL_ENABLED=true
AGENT_POLL_INTERVAL_MS=90000

# Set on Vercel (no claude CLI) — UI + merge still work; run `npm run worker` locally for agents
# DISPATCH_DISABLED=true

# Server port (local / Railway / Fly)
PORT=3001
