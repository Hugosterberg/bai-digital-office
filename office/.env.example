# =============================================================================
# bai digital office — environment variables
# =============================================================================

# --- GitHub (Vercel + worker) ------------------------------------------------

GITHUB_TOKEN=

# --- Vercel (UI + API only) --------------------------------------------------

OFFICE_SECRET=
DISPATCH_DISABLED=true
AGENT_POLL_ENABLED=false

# Ping hosted worker immediately when you create a task (Railway public URL)
WORKER_WEBHOOK_URL=https://YOUR-WORKER.up.railway.app/poll
WORKER_SECRET=

# --- Notifications (both hosts) ----------------------------------------------

# Slack incoming webhook — PR ready, pipeline failed, blocked tasks, incidents, auto-merges
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Automation levels (worker) ----------------------------------------------

# Failed pipeline attempts before a task is parked as agent:blocked (default 2)
# AGENT_MAX_ATTEMPTS=2
# Auto-merge safety: max changed lines for autonomy=auto-safe (default 400)
# AUTO_MERGE_MAX_LINES=400
# Site monitor: checks all project domains, opens incident issues on failure
# SITE_MONITOR_ENABLED=true
# SITE_MONITOR_INTERVAL_MS=1800000
# Wait after auto-merge before probing the domain (default 3 min)
# POST_DEPLOY_DELAY_MS=180000
# Weekly auto-cycle: growth ideas → prioritizer promotes the best to agent:ready
# AUTO_CYCLE_ENABLED=true
# AUTO_CYCLE_INTERVAL_MS=604800000

# --- Railway worker (always-on agents) — same repo, root `office` ------------

# ANTHROPIC_API_KEY=sk-ant-...     # console.anthropic.com — bills API usage
# Agent team models (overridable in Settings → Agent team; env is fallback)
# AGENT_MODEL_ANALYZE=claude-sonnet-4-6
# AGENT_MODEL_IMPLEMENT=claude-opus-4-6
# AGENT_MODEL_VALIDATE=claude-sonnet-4-6
# AGENT_MODEL_GROWTH=claude-opus-4-6
# AGENT_MODEL_RESEARCH=claude-sonnet-4-6
# Persisted UI settings: server/data/agent-team.json (mount Railway volume at /app/server/data)
# Or Claude Code subscription via claude login on first deploy (prefer API key in cloud)
# GITHUB_TOKEN=                    # same as Vercel
# WORKER_SECRET=                   # same as Vercel — protects POST /poll
# DISPATCH_DISABLED=false
# AGENT_POLL_ENABLED=true
# AGENT_POLL_INTERVAL_MS=90000

# --- Local dev only ------------------------------------------------------------

# DISPATCH_DISABLED=false
# AGENT_POLL_ENABLED=true
# AGENT_POLL_INTERVAL_MS=90000
# PORT=3001
